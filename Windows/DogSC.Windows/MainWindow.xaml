<Window x:Class="DogSC.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}"
        Title="DogSC · Windows录屏" Width="1120" Height="850" MinWidth="930" MinHeight="700"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing" StateChanged="Window_StateChanged">
  <Grid Margin="30">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,24">
      <Button x:Name="OpenProjectButton" DockPanel.Dock="Right" VerticalAlignment="Center" Content="打开项目(_O)" Click="OpenProjectButton_Click" />
      <StackPanel>
        <StackPanel Orientation="Horizontal">
          <TextBlock Text="DogSC" FontSize="30" FontWeight="Bold" />
          <Border Background="#D6F2E6" CornerRadius="8" Padding="9,3" Margin="13,8,0,0" VerticalAlignment="Top">
            <TextBlock Text="WINDOWS" FontSize="11" FontWeight="SemiBold" Foreground="#486358" />
          </Border>
        </StackPanel>
        <TextBlock Text="Ctrl+Shift+S显示/隐藏悬浮条 · Ctrl+Shift+空格暂停/继续" Foreground="{StaticResource MutedInk}" Margin="0,8,0,0" />
      </StackPanel>
    </DockPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="380" />
        <ColumnDefinition Width="24" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <Border Style="{StaticResource Card}">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel x:Name="SourceConfiguration">
            <TextBlock Text="录制设置" FontSize="19" FontWeight="SemiBold" Margin="0,0,0,15" />
            <Label Content="界面语言 / Language" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="LanguageCombo" SelectedIndex="0" SelectionChanged="LanguageCombo_SelectionChanged" Margin="0,0,0,12" AutomationProperties.Name="界面语言"><ComboBoxItem Content="简体中文" Tag="zh" /><ComboBoxItem Content="English" Tag="en" /></ComboBox>
            <Label Content="录制方式(_M)" Target="{Binding ElementName=ModeCombo}" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="ModeCombo" SelectedIndex="2" SelectionChanged="ModeCombo_SelectionChanged" AutomationProperties.Name="录制方式">
              <ComboBoxItem Content="整个屏幕" Tag="screen" />
              <ComboBoxItem Content="指定窗口" Tag="window" />
              <ComboBoxItem Content="屏幕区域" Tag="region" />
            </ComboBox>
            <Label x:Name="SourceLabel" Content="选择屏幕(_D)" Target="{Binding ElementName=SourceCombo}" Style="{StaticResource FieldLabel}" Margin="0,14,0,0" />
            <DockPanel>
              <Button x:Name="RefreshButton" DockPanel.Dock="Right" Content="刷新(_R)" Padding="11,6" Margin="9,0,0,0" Click="RefreshButton_Click" />
              <ComboBox x:Name="SourceCombo" DisplayMemberPath="Name" SelectionChanged="SourceCombo_SelectionChanged" AutomationProperties.Name="录制来源" />
            </DockPanel>
            <StackPanel x:Name="RegionPanel" Visibility="Collapsed" Margin="0,12,0,0">
              <Button x:Name="ChooseRegionButton" Content="拖拽选择区域(_G)" Click="ChooseRegionButton_Click" />
              <TextBlock x:Name="RegionText" Text="尚未选择区域" Foreground="{StaticResource MutedInk}" Margin="0,7,0,0" TextWrapping="Wrap" />
            </StackPanel>
            <Label Content="目标帧率(_F)" Target="{Binding ElementName=FrameRateCombo}" Style="{StaticResource FieldLabel}" Margin="0,14,0,0" />
            <ComboBox x:Name="FrameRateCombo" SelectedIndex="0" SelectionChanged="RecordingConfiguration_Changed" AutomationProperties.Name="录制帧率">
              <ComboBoxItem Content="30 fps · 日常录制" Tag="30" />
              <ComboBoxItem Content="60 fps · 更流畅" Tag="60" />
              <ComboBoxItem Content="120 fps · 高帧率" Tag="120" />
            </ComboBox>
            <Label x:Name="ResolutionLabel" Content="录制规格(_Q)" Target="{Binding ElementName=ResolutionCombo}" Style="{StaticResource FieldLabel}" Margin="0,14,0,0" />
            <ComboBox x:Name="ResolutionCombo" SelectedIndex="0" SelectionChanged="RecordingConfiguration_Changed" AutomationProperties.Name="录制规格">
              <ComboBoxItem Content="原始分辨率" Tag="0" />
              <ComboBoxItem Content="1080P · 1920×1080" Tag="1080" />
              <ComboBoxItem Content="720P · 1280×720" Tag="720" />
            </ComboBox>
            <TextBlock Text="全屏按所选规格录制；框选按选区实际像素保存。帧率独立选择。" Foreground="{StaticResource MutedInk}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" />
            <CheckBox x:Name="ComposeFinalCheck" Content="成片合成" IsChecked="True" Checked="RecordingConfiguration_Changed" Unchecked="RecordingConfiguration_Changed" Margin="0,12,0,0" ToolTip="开启运镜、放大等效果；关闭直接保存原片。鼠标和摄像头实时录入，不另存摄像头视频。" AutomationProperties.Name="开启运镜等成片效果；关闭保留鼠标和摄像头基础画面" />
            <TextBlock Text="声音" FontWeight="SemiBold" Margin="0,15,0,9" />
            <Label Content="录制编码" Style="{StaticResource FieldLabel}" />
            <ComboBox x:Name="CodecCombo" SelectedIndex="0" AutomationProperties.Name="录制编码">
              <ComboBoxItem Content="H.264 · MP4" Tag="H264" />
              <ComboBoxItem Content="HEVC · 按本机能力检测" Tag="HEVC" />
              <ComboBoxItem Content="ProRes 422 · 当前无编码插件" Tag="ProRes" IsEnabled="False" />
            </ComboBox>
            <CheckBox x:Name="SystemAudioCheck" Content="系统声音(_S)" IsChecked="True" Checked="RecordingConfiguration_Changed" Unchecked="RecordingConfiguration_Changed" Margin="0,0,0,11" />
            <CheckBox x:Name="ProcessAudioCheck" Content="只录所选窗口应用及其子进程声音" IsEnabled="False" Margin="0,0,0,10" ToolTip="仅窗口录制可用；不把其它应用或整机声音混入视频。" />
            <CheckBox x:Name="MicrophoneCheck" Content="默认麦克风(_V)" Checked="RecordingConfiguration_Changed" Unchecked="RecordingConfiguration_Changed" Margin="0,0,0,0" />
            <ComboBox x:Name="OutputDeviceCombo" DisplayMemberPath="Name" SelectionChanged="RecordingConfiguration_Changed" Margin="0,6,0,0" AutomationProperties.Name="系统声音设备" />
            <ComboBox x:Name="InputDeviceCombo" DisplayMemberPath="Name" SelectionChanged="RecordingConfiguration_Changed" Margin="0,6,0,0" AutomationProperties.Name="麦克风设备" />
            <TextBlock Text="麦克风录制音量" Margin="0,8,0,0" />
            <Slider x:Name="MicrophoneVolumeSlider" Minimum="0" Maximum="1" Value="1" SmallChange="0.05" ValueChanged="RecordingVolume_Changed" AutomationProperties.Name="麦克风录制音量" />
            <TextBlock Text="系统声音录制音量" Margin="0,6,0,0" />
            <Slider x:Name="SystemVolumeSlider" Minimum="0" Maximum="1" Value="1" SmallChange="0.05" ValueChanged="RecordingVolume_Changed" AutomationProperties.Name="系统声音录制音量" />
            <TextBlock Text="使用Windows当前默认音频设备。" Foreground="{StaticResource MutedInk}" FontSize="12" Margin="0,10,0,0" />
            <Label Content="摄像头（录入原片）" Style="{StaticResource FieldLabel}" Margin="0,14,0,0" />
            <ComboBox x:Name="CameraCombo" DisplayMemberPath="Name" SelectionChanged="CameraCombo_SelectionChanged" AutomationProperties.Name="摄像头来源" />
            <ComboBox x:Name="CameraFormatCombo" SelectionChanged="RecordingConfiguration_Changed" Margin="0,6,0,0" IsEnabled="False" AutomationProperties.Name="摄像头实际格式" />
            <TextBlock x:Name="CapabilityText" Text="摄像头默认关闭；编码能力按本机检测。" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedInk}" Margin="0,7,0,0" />
            <TextBlock Text="成片合成只控制运镜、放大等效果；摄像头直接录入屏幕原片，不保存独立摄像头视频。" TextWrapping="Wrap" FontSize="11" Foreground="{StaticResource MutedInk}" Margin="0,6,0,0" />
            <CheckBox x:Name="RecoverableCheck" Content="可恢复MP4分片（意外退出保留完整分片）" Margin="0,12,0,0" />
            <Border Height="1" Background="#E7EAE6" Margin="0,17,0,16" />
            <Label Visibility="Collapsed" Content="项目名称(_N)" Target="{Binding ElementName=TitleBox}" Style="{StaticResource FieldLabel}" />
            <TextBox x:Name="TitleBox" Visibility="Collapsed" MaxLength="100" AutomationProperties.Name="项目名称" />
            <Label Content="保存位置(_L)" Target="{Binding ElementName=FolderBox}" Style="{StaticResource FieldLabel}" Margin="0,14,0,0" />
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="浏览(_B)" Padding="10,7" Margin="8,0,0,0" Click="BrowseFolderButton_Click" AutomationProperties.Name="选择项目保存文件夹" />
              <TextBox x:Name="FolderBox" AutomationProperties.Name="项目保存父目录" />
            </DockPanel>
            <TextBlock Text="按开始时间保存文件夹，内含成片MP4、可选M4A及独立素材子文件夹。" Foreground="{StaticResource MutedInk}" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0" />
          </StackPanel>
        </ScrollViewer>
      </Border>

      <Border Grid.Column="2" Style="{StaticResource Card}">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>
          <DockPanel>
            <Border DockPanel.Dock="Right" Background="#EDF5F1" CornerRadius="9" Padding="11,6">
              <TextBlock x:Name="StateBadge" Text="准备就绪" Foreground="{StaticResource MutedInk}" FontSize="12" FontWeight="SemiBold" />
            </Border>
            <TextBlock Text="录制工作台" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
          </DockPanel>

          <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,24,0,24">
            <Border Background="#F6F8F9" CornerRadius="16" Padding="25,30">
              <StackPanel HorizontalAlignment="Center">
                <TextBlock x:Name="ClockText" Text="00:00:00" FontSize="55" FontWeight="Light" FontFamily="Consolas" HorizontalAlignment="Center" AutomationProperties.Name="已录制时长" />
                <TextBlock x:Name="SessionHeading" Text="准备开始你的录制" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,14,0,0" TextAlignment="Center" TextWrapping="Wrap" />
                <TextBlock x:Name="SessionDetail" Text="选择来源和声音，然后点击开始录制。" Foreground="{StaticResource MutedInk}" Margin="0,9,0,0" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="370" />
              </StackPanel>
            </Border>
            <TextBlock x:Name="ProjectPathText" Text="尚未打开或保存项目" Foreground="{StaticResource MutedInk}" FontSize="12" Margin="0,14,0,0" TextWrapping="Wrap" />
          </StackPanel>

          <StackPanel Grid.Row="2">
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
              <Button x:Name="StartButton" Content="开始录制(_A)" Style="{StaticResource PrimaryButton}" Click="StartButton_Click" Margin="0,0,7,0" />
              <Button x:Name="PauseButton" Grid.Column="1" Content="暂停(_P)" Click="PauseButton_Click" IsEnabled="False" Margin="0,0,7,0" />
              <Button x:Name="StopButton" Grid.Column="2" Content="停止(_T)" Click="StopButton_Click" IsEnabled="False" />
            </Grid>
            <Border Height="1" Background="#E7EAE6" Margin="0,23,0,18" />
            <TextBlock Text="项目文件" FontWeight="SemiBold" Margin="0,0,0,10" />
            <WrapPanel>
              <Button Content="关于与权限" Click="AboutButton_Click" Margin="0,0,8,8" />
              <Button Content="打开原版项目（只读）" Click="OpenLegacyButton_Click" Margin="0,0,8,8" />
              <Button Content="导入原版项目" Click="ImportLegacyButton_Click" Margin="0,0,8,8" />
              <Button x:Name="EditButton" Content="编辑视频" IsEnabled="False" Click="EditButton_Click" Margin="0,0,8,8" />
              <Button Content="备忘录" Click="MemoButton_Click" Margin="0,0,8,8" />
              <Button x:Name="MarkerButton" Content="添加标记" Click="MarkerButton_Click" IsEnabled="False" Margin="0,0,8,8" />
              <Button x:Name="PlayButton" Content="播放(_Y)" IsEnabled="False" Click="PlayButton_Click" Margin="0,0,8,8" />
              <Button x:Name="OpenFolderButton" Content="打开目录(_I)" IsEnabled="False" Click="OpenFolderButton_Click" Margin="0,0,8,8" />
              <Button x:Name="ExportButton" Content="导出MP4(_E)" IsEnabled="False" Click="ExportButton_Click" Margin="0,0,0,8" />
              <Button x:Name="CancelExportButton" Content="取消导出(_C)" Visibility="Collapsed" Click="CancelExportButton_Click" Margin="8,0,0,8" />
              <Button x:Name="ForceExitButton" Content="强制退出" Visibility="Collapsed" Click="ForceExitButton_Click" Margin="8,0,0,8" />
            </WrapPanel>
            <TextBlock Text="录制与原始MP4导出，保持所选帧率和录制规格。" Foreground="{StaticResource MutedInk}" FontSize="12" TextWrapping="Wrap" Margin="0,7,0,0" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="2" Background="#EDF2F4" CornerRadius="10" Padding="12,10" Margin="0,18,0,0">
      <TextBlock x:Name="StatusText" Text="正在获取录制来源…" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
    </Border>
  </Grid>
</Window>
