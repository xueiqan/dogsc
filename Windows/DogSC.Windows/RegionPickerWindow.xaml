<Window x:Class="DogSC.Windows.RegionPickerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}"
        Title="选择录制区域" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="#01000000" Topmost="True" ShowInTaskbar="False" Cursor="Cross"
        KeyDown="Window_KeyDown" Loaded="Window_Loaded">
  <Grid x:Name="SelectionSurface" Background="Transparent" SizeChanged="SelectionSurface_SizeChanged"
        MouseLeftButtonDown="Surface_MouseLeftButtonDown" MouseMove="Surface_MouseMove"
        MouseLeftButtonUp="Surface_MouseLeftButtonUp">
    <Path Fill="#80000000" IsHitTestVisible="False">
      <Path.Data>
        <GeometryGroup FillRule="EvenOdd">
          <RectangleGeometry x:Name="DimmedScreen" />
          <RectangleGeometry x:Name="ClearSelection" />
        </GeometryGroup>
      </Path.Data>
    </Path>
    <Canvas IsHitTestVisible="False">
      <Border x:Name="SelectionOutline" BorderBrush="#5EEDCC" BorderThickness="3" Visibility="Collapsed" />
    </Canvas>
    <Border Background="#E820252B" Padding="18,12" CornerRadius="7" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="12,24,12,0" IsHitTestVisible="False">
      <TextBlock x:Name="InstructionText" Text="按住鼠标拖拽选择录制区域 · Esc取消" Foreground="White" FontSize="16" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
    </Border>
  </Grid>
</Window>
