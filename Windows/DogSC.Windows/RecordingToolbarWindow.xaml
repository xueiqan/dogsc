<Window x:Class="DogSC.Windows.RecordingToolbarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Style="{StaticResource {x:Type Window}}" Title="DogSC录制悬浮条" Width="800" Height="141.6"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        SourceInitialized="Window_SourceInitialized" Loaded="Window_Loaded" Closing="Window_Closing">
  <Window.Resources>
    <Style x:Key="ToolbarButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Padding" Value="12,7" /><Setter Property="MinHeight" Value="34" /><Setter Property="FontSize" Value="12" />
    </Style>
    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
      <Setter Property="Padding" Value="6,4" /><Setter Property="MinHeight" Value="29" /><Setter Property="FontSize" Value="12" />
    </Style>
    <Style x:Key="SourceTile" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource MutedInk}" /><Setter Property="Width" Value="65" /><Setter Property="Height" Value="63" />
      <Setter Property="Cursor" Value="Hand" /><Setter Property="Template"><Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Tile" Background="Transparent" CornerRadius="12" Padding="5"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Tile" Property="Background" Value="{StaticResource MintWash}" /><Setter Property="Foreground" Value="{StaticResource Ink}" /></Trigger>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="Opacity" Value="0.7" /></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Tile" Property="BorderBrush" Value="{StaticResource Ink}" /><Setter TargetName="Tile" Property="BorderThickness" Value="1" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value></Setter>
    </Style>
    <Style x:Key="InputOrb" TargetType="CheckBox">
      <Setter Property="Width" Value="49" /><Setter Property="Height" Value="49" /><Setter Property="Margin" Value="7,0,0,0" /><Setter Property="Foreground" Value="{StaticResource Ink}" /><Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <Grid>
          <Border x:Name="InputTile" CornerRadius="12" BorderBrush="#E1E5E7" BorderThickness="0.7" Background="#F8FAFB" />
          <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          <Path x:Name="OffSlash" Data="M8,41 L41,8" Stroke="#DD303F" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" IsHitTestVisible="False" />
        </Grid>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="OffSlash" Property="Visibility" Value="Collapsed" /><Setter TargetName="InputTile" Property="Background" Value="{StaticResource MintWash}" /></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.8" /></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Foreground" Value="{StaticResource Mint}" /></Trigger>
          <Trigger Property="Tag" Value="configuring"><Setter TargetName="OffSlash" Property="Visibility" Value="Collapsed" /><Setter TargetName="InputTile" Property="Background" Value="#E5E7E9" /><Setter Property="Foreground" Value="#91979D" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="ComposeToggle" TargetType="CheckBox">
      <Setter Property="FontSize" Value="11" /><Setter Property="Cursor" Value="Hand" /><Setter Property="Foreground" Value="#5D666C" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
        <Border x:Name="ComposeTile" CornerRadius="8" Padding="5,4" Background="#E5E7E9" BorderBrush="#CAD0D3" BorderThickness="0.7">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Grid Width="16" Height="16" Margin="0,0,4,0"><Path Data="M1,3 L15,3 L15,13 L1,13 Z M1,6 L15,6 M5,3 L7,6 M10,3 L12,6" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.2" /></Grid>
            <ContentPresenter VerticalAlignment="Center" />
          </StackPanel>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsChecked" Value="True"><Setter TargetName="ComposeTile" Property="Background" Value="{StaticResource MintWash}" /><Setter TargetName="ComposeTile" Property="BorderBrush" Value="{StaticResource Mint}" /><Setter Property="Foreground" Value="#197648" /></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComposeTile" Property="Opacity" Value="0.8" /></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ComposeTile" Property="BorderBrush" Value="{StaticResource Ink}" /></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Cursor" Value="Arrow" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="OrbButton" TargetType="Button" BasedOn="{StaticResource ToolbarButton}">
      <Setter Property="Width" Value="49" /><Setter Property="Height" Value="49" /><Setter Property="Margin" Value="7,0,0,0" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border CornerRadius="25" BorderBrush="#E1E5E7" BorderThickness="0.7" Background="#F8FAFB"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.75" /></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Foreground" Value="{StaticResource Mint}" /></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Border x:Name="ToolbarSurface" Width="1000" Height="177" CornerRadius="24" BorderBrush="#E5E9EA" BorderThickness="1" Padding="18,12" Background="White" PreviewMouseLeftButtonDown="DragSurface_MouseLeftButtonDown" ToolTip="拖动空白处移动整个悬浮条">
    <Border.LayoutTransform><ScaleTransform ScaleX="0.8" ScaleY="0.8" /></Border.LayoutTransform>
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="70" /><RowDefinition Height="35" /><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <Grid x:Name="Configuration" Grid.RowSpan="2" Grid.ColumnSpan="2">
        <Grid.RowDefinitions><RowDefinition Height="70" /><RowDefinition Height="35" /></Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
          <RadioButton x:Name="ScreenMode" Style="{StaticResource SourceTile}" GroupName="SourceKind" Tag="screen" Checked="SourceTile_Checked" AutomationProperties.Name="显示器录制" ToolTip="显示器：录制所选显示器的整个画面。">
            <StackPanel><Path Data="M1,1 L30,1 L30,22 L1,22 Z M12,23 L19,23 M15,23 L15,29 M9,29 L22,29" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.8" Width="31" Height="30" Margin="0,0,0,5" /><TextBlock Text="显示器" FontSize="11" HorizontalAlignment="Center" /></StackPanel>
          </RadioButton>
          <RadioButton x:Name="WindowMode" Style="{StaticResource SourceTile}" GroupName="SourceKind" Tag="window" Checked="SourceTile_Checked" AutomationProperties.Name="窗口录制" ToolTip="窗口：只录制选定窗口；窗口关闭或最小化时停止并保存。">
            <StackPanel><Path Data="M3,2 L28,2 Q31,2 31,5 L31,24 Q31,27 28,27 L3,27 Q0,27 0,24 L0,5 Q0,2 3,2 Z M4,7 L5,7 M8,7 L9,7 M12,7 L13,7" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.8" Width="31" Height="30" Margin="0,0,0,5" /><TextBlock Text="窗口" FontSize="11" HorizontalAlignment="Center" /></StackPanel>
          </RadioButton>
          <RadioButton x:Name="RegionMode" Style="{StaticResource SourceTile}" GroupName="SourceKind" Tag="region" Checked="SourceTile_Checked" AutomationProperties.Name="区域录制" ToolTip="区域：点击开始后拖拽框选，Esc取消。录制区域会显示提示边框。">
            <StackPanel><Rectangle Width="30" Height="25" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.8" StrokeDashArray="3,2" RadiusX="2" RadiusY="2" Margin="0,2,0,8" /><TextBlock Text="区域" FontSize="11" HorizontalAlignment="Center" /></StackPanel>
          </RadioButton>
          <ComboBox x:Name="ModeCombo" Visibility="Collapsed" SelectedIndex="0" SelectionChanged="ModeCombo_SelectionChanged"><ComboBoxItem Content="框选区域" Tag="region" /><ComboBoxItem Content="全屏录制" Tag="screen" /><ComboBoxItem Content="指定窗口" Tag="window" /></ComboBox>
          <Border Width="1" Height="34" Background="#E3E7E9" Margin="17,12,9,0" VerticalAlignment="Top" />
          <CheckBox x:Name="MicrophoneCheck" Style="{StaticResource InputOrb}" Checked="Configuration_Changed" Unchecked="Configuration_Changed" ToolTip="麦克风：点击开关，自动选择可用蓝牙麦克风，否则使用系统默认。红斜杠为关闭，灰色为配置中，绿色为就绪。" AutomationProperties.Name="录制默认麦克风">
            <Path Data="M10,1 Q5,1 5,6 L5,16 Q5,21 10,21 Q15,21 15,16 L15,6 Q15,1 10,1 Z M1,14 L1,17 Q1,26 10,26 Q19,26 19,17 L19,14 M10,26 L10,31 M5,31 L15,31" Width="23" Height="30" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=CheckBox}}" StrokeThickness="1.8" />
          </CheckBox>
          <CheckBox x:Name="CameraButton" Style="{StaticResource InputOrb}" Checked="CameraButton_Changed" Unchecked="CameraButton_Changed" ToolTip="摄像头：点击开关，默认选择最高分辨率及该分辨率下的最高帧率。" AutomationProperties.Name="录制摄像头">
            <Path Data="M2,5 L20,5 Q23,5 23,8 L23,23 Q23,26 20,26 L2,26 Q0,26 0,23 L0,8 Q0,5 2,5 Z M23,11 L33,6 L33,25 L23,20" Width="31" Height="27" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=CheckBox}}" StrokeThickness="1.8" />
          </CheckBox>
          <CheckBox x:Name="SystemAudioCheck" Style="{StaticResource InputOrb}" IsChecked="True" Checked="Configuration_Changed" Unchecked="Configuration_Changed" ToolTip="系统声音：默认开启。红斜杠为关闭，灰色为配置中，绿色为就绪。" AutomationProperties.Name="录制系统声音">
            <Path Data="M1,10 L8,10 L17,3 L17,28 L8,21 L1,21 Z M22,9 Q29,15 22,22 M27,4 Q38,15 27,28" Width="30" Height="29" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=CheckBox}}" StrokeThickness="1.8" />
          </CheckBox>
          <CheckBox x:Name="MemoButton" Style="{StaticResource InputOrb}" Click="MemoButton_Click" ToolTip="备忘录（排除录屏）" AutomationProperties.Name="打开备忘录">
            <Path Data="M2,2 L26,2 Q29,2 29,5 L29,24 Q29,27 26,27 L2,27 Q0,27 0,24 L0,5 Q0,2 2,2 Z M5,8 L24,8 M5,13 L24,13 M5,18 L19,18" Width="25" Height="24" Stretch="Uniform" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=CheckBox}}" StrokeThickness="1.8" />
          </CheckBox>
          <Button x:Name="AudioSettingsButton" Style="{StaticResource OrbButton}" Click="AudioSettingsButton_Click" ToolTip="录制音量：分别调整麦克风和系统声音，不更改Windows音量。" AutomationProperties.Name="录制音量">
            <Path Data="M5,1 L5,28 M15,1 L15,28 M25,1 L25,28 M1,8 L9,8 M11,20 L19,20 M21,12 L29,12" Width="27" Height="27" Stroke="{StaticResource Ink}" StrokeThickness="2" />
          </Button>
          <Border Width="1" Height="34" Background="#E3E7E9" Margin="18,12,15,0" VerticalAlignment="Top" />
          <Border Background="Transparent" Cursor="SizeAll" Padding="0,8" ToolTip="拖动移动悬浮条">
            <StackPanel><TextBlock Text="DogSC" FontWeight="SemiBold" FontSize="13" /><TextBlock x:Name="StateText" Text="准备就绪" Foreground="{StaticResource MutedInk}" FontSize="11" Margin="0,5,0,0" /><TextBlock x:Name="ClockText" Text="00:00:00" FontFamily="Consolas" FontSize="13" AutomationProperties.Name="录制时长" /></StackPanel>
          </Border>
        </StackPanel>
        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="35" /><ColumnDefinition Width="90" /><ColumnDefinition x:Name="ResolutionColumn" Width="174" /><ColumnDefinition Width="101" /><ColumnDefinition Width="75" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
          <ComboBox x:Name="SourceCombo" DisplayMemberPath="Name" SelectionChanged="SourceCombo_SelectionChanged" AutomationProperties.Name="录制来源"><ComboBox.ToolTip><ToolTip Content="{Binding PlacementTarget.SelectedItem.Name, RelativeSource={RelativeSource Self}}" /></ComboBox.ToolTip></ComboBox>
          <Button x:Name="RefreshButton" Grid.Column="1" Content="↻" Style="{StaticResource ToolbarButton}" Padding="4,2" Click="RefreshButton_Click" Margin="5,0,0,0" ToolTip="刷新录制来源" AutomationProperties.Name="刷新录制来源" />
          <ComboBox x:Name="FrameRateCombo" Grid.Column="2" SelectedIndex="0" Margin="7,0,0,0" SelectionChanged="FrameRateCombo_SelectionChanged" AutomationProperties.Name="目标帧率" ToolTip="帧率：30/60/120fps直接控制采集与编码频率；越高越流畅，所需性能越高。"><ComboBoxItem Content="30 fps" Tag="30" /><ComboBoxItem Content="60 fps" Tag="60" /><ComboBoxItem Content="120 fps" Tag="120" /></ComboBox>
          <ComboBox x:Name="ResolutionCombo" Grid.Column="3" SelectedIndex="0" Margin="7,0,0,0" SelectionChanged="Configuration_Changed" AutomationProperties.Name="录制规格" ToolTip="录制规格：原始分辨率跟随所选显示器的实际像素，4K屏录4K；1080P=1920×1080；720P=1280×720。标准规格等比缩放并留边。"><ComboBoxItem Content="原始分辨率" Tag="0" /><ComboBoxItem Content="1080P · 1920×1080" Tag="1080" /><ComboBoxItem Content="720P · 1280×720" Tag="720" /></ComboBox>
          <CheckBox x:Name="ComposeFinalCheck" Grid.Column="4" Content="成片合成" Style="{StaticResource ComposeToggle}" IsChecked="True" Checked="Configuration_Changed" Unchecked="Configuration_Changed" VerticalAlignment="Center" Margin="7,0,0,0" ToolTip="开启运镜、放大等效果；关闭直接保存原片。鼠标和摄像头实时录入，不另存摄像头视频。" AutomationProperties.Name="开启运镜等成片效果；关闭保留鼠标和摄像头基础画面" />
          <CheckBox x:Name="QuietCheck" Grid.Column="5" Content="免打扰" IsChecked="False" FontSize="11" VerticalAlignment="Center" Margin="7,0,0,0" ToolTip="可选，默认关闭；第三方提示需单独处理。" AutomationProperties.Name="临时开启录制免打扰" />
          <Button x:Name="QuietSettingsButton" Grid.Column="6" Content="通知设置" Style="{StaticResource ToolbarButton}" Click="QuietSettingsButton_Click" Margin="7,0,0,0" ToolTip="打开Windows通知设置，录制前可手动开启免打扰。" AutomationProperties.Name="打开Windows免打扰设置" />
        </Grid>
      </Grid>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="0,10,0,0">
        <Button x:Name="StartStopButton" Content="开始(_A)" Style="{StaticResource ToolbarButton}" Background="{StaticResource Accent}" BorderBrush="{StaticResource Accent}" Foreground="White" ToolTip="开始或停止录制" Click="StartStopButton_Click" Margin="0,0,7,0" />
        <Button x:Name="PauseButton" Content="暂停(_P)" Style="{StaticResource ToolbarButton}" ToolTip="暂停或继续录制：Ctrl+Shift+空格" Click="PauseButton_Click" IsEnabled="False" Margin="0,0,7,0" />
        <Button x:Name="SettingsButton" Style="{StaticResource ToolbarButton}" Click="SettingsButton_Click" Margin="0,0,7,0" AutomationProperties.Name="录制设置和保存项目" ToolTip="保存与设置：默认保存到D:\视频，可更改设备、编码和位置。"><StackPanel><TextBlock Text="保存到" Foreground="{StaticResource MutedInk}" FontSize="10" /><TextBlock Text="视频 / 项目⌄" FontSize="12" /></StackPanel></Button>
        <Button x:Name="HideButton" Content="×" Style="{StaticResource ToolbarButton}" FontSize="22" Padding="10,2" Click="HideButton_Click" ToolTip="Ctrl+Shift+S显示/隐藏悬浮条" AutomationProperties.Name="隐藏悬浮条" />
      </StackPanel>
      <TextBlock x:Name="StatusText" Grid.Row="2" Grid.ColumnSpan="2" Margin="0,8,0,0" FontSize="11" Foreground="{StaticResource MutedInk}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite"><TextBlock.ToolTip><ToolTip Content="{Binding PlacementTarget.Text, RelativeSource={RelativeSource Self}}" /></TextBlock.ToolTip></TextBlock>
      <Border x:Name="AudioPanel" Grid.Row="3" Grid.ColumnSpan="2" Visibility="Collapsed" Height="70" Margin="0,8,0,0" Padding="12,7" Background="#F5F8F7" CornerRadius="12">
        <Grid>
          <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="24" /><ColumnDefinition /></Grid.ColumnDefinitions>
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
            <TextBlock Text="麦克风音量" VerticalAlignment="Center" />
            <Slider x:Name="MicrophoneVolumeSlider" Grid.Column="1" Minimum="0" Maximum="1" Value="1" SmallChange="0.05" LargeChange="0.1" VerticalAlignment="Center" ValueChanged="AudioVolume_Changed" AutomationProperties.Name="麦克风录制音量" />
            <TextBlock x:Name="MicrophoneVolumeText" Grid.Column="2" Text="100%" HorizontalAlignment="Right" VerticalAlignment="Center" />
          </Grid>
          <Grid Grid.Column="2">
            <Grid.ColumnDefinitions><ColumnDefinition Width="70" /><ColumnDefinition /><ColumnDefinition Width="48" /></Grid.ColumnDefinitions>
            <TextBlock Text="系统声音" VerticalAlignment="Center" />
            <Slider x:Name="SystemVolumeSlider" Grid.Column="1" Minimum="0" Maximum="1" Value="1" SmallChange="0.05" LargeChange="0.1" VerticalAlignment="Center" ValueChanged="AudioVolume_Changed" AutomationProperties.Name="系统声音录制音量" />
            <TextBlock x:Name="SystemVolumeText" Grid.Column="2" Text="100%" HorizontalAlignment="Right" VerticalAlignment="Center" />
          </Grid>
        </Grid>
      </Border>
    </Grid>
  </Border>
</Window>
